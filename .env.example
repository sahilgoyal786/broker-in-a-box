# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar sync (via Maton gateway)
MATON_API_KEY=
GOOGLE_CALENDAR_CONNECTION_ID=

# Google OAuth (Gmail/Drive/Calendar broker integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (transactional email)
RESEND_API_KEY=

# SMTP fallback for email sending
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Misc
DATABASE_URL=
NEXT_PUBLIC_APP_URL=
